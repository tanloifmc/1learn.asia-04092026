    "test:live:browser-auth": "node ./scripts/run-live-browser-auth.mjs",
    "test:live:browser-provider": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-provider.spec.ts",
    "test:live:browser-inquiries": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-inquiries.spec.ts",
    "test:live:browser-admin-provider": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-admin-provider.spec.ts",
    "test:live:browser-membership": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-membership.spec.ts",
    "test:live:browser-register": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-registration.spec.ts",
    "test:live:browser-account": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-account.spec.ts",
    "test:live:browser-cms": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-cms.spec.ts",
    "test:live:browser-shared-core": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-shared-core.spec.ts",
    "test:live:browser-media": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-media.spec.ts",
    "test:live:browser-roles": "node ./scripts/run-live-browser-auth.mjs tests/e2e/live-roles.spec.ts",
    "test:live:browser-branding": "node ./scripts/run-live-browser-auth.mjs --workers=1 tests/e2e/live-branding.spec.ts",
    "check:env": "node ./scripts/check-environment-contract.mjs"
